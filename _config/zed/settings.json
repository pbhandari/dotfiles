// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "flexible": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "tab_bar": {
    "show": false
  },
  "icon_theme": "Catppuccin Frappé",
  "terminal": {
    "font_size": 14.0,
    "blinking": "on",
    "option_as_meta": true,
    "copy_on_select": true,
    "max_scroll_history_lines": 100000,
  },
  "project_panel": {
    "hide_gitignore": true,
    "git_status": false,
    "auto_fold_dirs": true,
  },
  "load_direnv": "shell_hook",
  "outline_panel": {
    "git_status": false,
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false,
  },
  "tabs": {
    "git_status": false,
    "show_close_button": "hidden",
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "relative_line_numbers": "enabled",
  "minimap": {
    "show": "never",
  },
  "hover_popover_delay": 500,
  "current_line_highlight": "all",
  "autosave": "off",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono", "Hiragino Sans"],
  "buffer_font_family": "Monaco",
  "file_types": {
    "yaml": ["*.yml.*"],
  },
  "semantic_tokens": "off",
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Solarized Light",
    "dark": "Solarized Dark",
  },
  "command_aliases": {
    "f": "file finder: toggle",
    "keymap": "zed: open keymap",
    "theme": "theme selector: toggle",
    "extensions": "zed: extensions",
  },
  "languages": {
    "Python": {
      "language_servers": ["basedpyright"],
    },
  },
}
